  "item": [
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log(pm.response.json().access_token)\r",
              "\r",
              "token = pm.response.json().access_token\r",
              "pm.collectionVariables.set(\"token\", token)\r",
              "\r",
              "console.log('****************************************')\r",
              "console.log(pm.collectionVariables.get(\"token\"))\r",
              "console.log('****************************************')"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"admin\",\r\n    \"password\": \"admin\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{host}}/auth/login",
          "host": [
            "{{host}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "New Request",
      "request": {
        "method": "GET",
        "header": []
      },
      "response": []
    },
    {
      "name": "Chat Message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"message\": \"What is home insurance?\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{host}}/chat/message",
          "host": [
            "{{host}}"
          ],
          "path": [
            "chat",
            "message"
          ]
        }
      },
      "response": []
    }
  ],
