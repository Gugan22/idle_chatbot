# Ignore the virtual environment directory
.venv
.venv/*

# Akilu changed this because runtime credentials and machine-specific settings
# must never be committed. Keep only the sanitized template.
.env
.env.*
!.env.example

# Ignore the .qodo directory
.qodo
.qodo/*

# Ignore the .vscode directory
.vscode
.vscode/*

# Ignore the .idea directory
.idea
.idea/*

# Ignore Python bytecode files
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore log files
*.log

# Ignore coverage reports
htmlcov/
.coverage
.coverage.*

# Ignore distribution files
dist/
build/
*.egg-info/

# Dependency lock files are intentionally not ignored.
