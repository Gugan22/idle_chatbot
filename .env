# =============================================================================
# .env — Insurance RAG Chatbot
# Place this file at the project root (same level as pyproject.toml)
#
# DO NOT commit this file to git.
# Commit .env.example instead (copy of this file with secrets blanked out).
# =============================================================================


# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8080
ENV=development
# Set ENV=production to disable Swagger UI (/docs)


# ── Auth (kept from your existing config) ─────────────────────────────────────
AUTH_SECRET=ceurybwe783287219ny9yayibcygavu1
TOKEN_TTL_SECONDS=900000
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=admin


# ── Qdrant (replaces the old DB_* postgres config) ────────────────────────────
# Local development — Qdrant running via Podman on your machine
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
COLLECTION_NAME=insurance_policies
# NOTE: When running inside podman-compose, the api service overrides
# QDRANT_HOST=qdrant automatically. You do not need to change this file.


# ── Redis semantic cache ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# TTL for cached FAQ answers — 7 days in seconds
CACHE_TTL_SECONDS=604800
# Cosine distance threshold — queries closer than this hit the cache
# 0.25 means ~97% similar. Lower = stricter matching.
CACHE_SIMILARITY_THRESHOLD=0.25
CACHE_MAX_SCAN=10000
# NOTE: Inside podman-compose, REDIS_URL is overridden to redis://redis:6379


# ── Embedding model ────────────────────────────────────────────────────────────
# Development: all-MiniLM-L6-v2 (384 dims, fast, runs on CPU)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384
EMBED_BATCH_SIZE=32
# Instruction prefixes — leave empty for all-MiniLM (symmetric model)
# For NV-Embed-v2 set: EMBED_DOC_PREFIX=passage:  EMBED_QUERY_PREFIX=query:
EMBED_DOC_PREFIX=
EMBED_QUERY_PREFIX=
# Akilu changed this because the embedding model is cached locally and network
# access checks prevent reliable local API startup.
EMBED_LOCAL_FILES_ONLY=true

# Production upgrade path (uncomment when switching to Nemotron Embed VL):
# EMBED_MODEL=nvidia/NV-Embed-v2
# EMBED_DIM=4096
# EMBED_DOC_PREFIX=passage:
# EMBED_QUERY_PREFIX=query:
# WARNING: changing EMBED_DIM requires recreating the Qdrant collection
# and re-ingesting all documents. Run: python setup_collection.py --recreate


# ── LLM ───────────────────────────────────────────────────────────────────────
# Option A — Local Ollama (easiest for development, no cost, no API key needed)
# Install Ollama from https://ollama.com then: ollama pull phi3
# Akilu changed this because the local Ollama instance currently exposes phi3:latest.
LLM_MODEL=phi3:latest
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-required

# Option B — NVIDIA NIM API (production, best quality, requires API key)
# Get your key from https://build.nvidia.com
# LLM_MODEL=nvidia/nemotron-3-8b-chat-4k
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option C — OpenAI (familiar fallback if NVIDIA NIM is not ready)
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512
# Akilu changed this because the local CPU-hosted phi3 model can take more
# than one minute to generate its first response.
LLM_TIMEOUT_SECONDS=180


# ── OpenAI API key (kept from your existing config) ───────────────────────────
# Used if you switch to Option C above, or for RAGAS evaluation
OPENAI_API_KEY=your_openai_api_key_here


# ── Reranker ──────────────────────────────────────────────────────────────────
# Development: lightweight cross-encoder (runs on CPU, no GPU needed)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Production upgrade:
# RERANKER_MODEL=nvidia/nv-rerankqa-mistral-4b-v3


# ── Retrieval tuning ──────────────────────────────────────────────────────────
# TOP_K: how many chunks Qdrant returns before reranking
TOP_K=20
# RERANK_TOP_N: how many chunks are passed to the LLM after reranking
RERANK_TOP_N=5
# SCORE_THRESHOLD: Qdrant discards results below this similarity score
SCORE_THRESHOLD=0.60
# RERANK_CONFIDENCE_FLOOR: if the best reranked chunk is below this,
# return "I don't have that information" instead of guessing
RERANK_CONFIDENCE_FLOOR=0.40
# Hard cap on context tokens sent to the LLM
CONTEXT_MAX_TOKENS=8000


# ── API security ──────────────────────────────────────────────────────────────
# Key required in the X-Ingest-Key header to call POST /ingest
# Change this to a strong random string before going to production
INGEST_API_KEY=dev-ingest-key-change-in-prod


# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# NEVER set LOG_RAW_QUERIES=true in production — PII risk
LOG_RAW_QUERIES=false
